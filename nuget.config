<?xml version="1.0" encoding="utf-8"?>
<!-- Sdcb.SimdOnnx pre-releases are published to the ProGet test feed until the engine ships on
     nuget.org; remove the "simdonnx-preview" source (and its mapping) before merging to main. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="simdonnx-preview" value="https://proget.starworks.cc:88/nuget/test/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="simdonnx-preview">
      <package pattern="Sdcb.SimdOnnx" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
