<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableThreads Condition="'$(WasmEnableThreads)' == ''">true</WasmEnableThreads>
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">true</RunAOTCompilation>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <!-- Prevent Directory.Build.targets from packing this benchmark project -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdPaddleOCR\Sdcb.SimdPaddleOCR.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.DocumentOrientation\Sdcb.SimdPaddleOCR.Models.DocumentOrientation.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny\Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.ChineseV6Small\Sdcb.SimdPaddleOCR.Models.ChineseV6Small.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.ChineseV6Medium\Sdcb.SimdPaddleOCR.Models.ChineseV6Medium.csproj" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <!-- Embed sample.jpg for instant zero-dependency smoke testing -->
  <ItemGroup>
    <Compile Include="..\Shared\DocumentOrientationValidation.cs" Link="DocumentOrientationValidation.cs" />
    <EmbeddedResource Include="..\..\examples\sample.jpg" LogicalName="orientation.sample.jpg" />
    <EmbeddedResource Include="..\..\models\orientation-manifest.json" LogicalName="orientation.manifest.json" />
  </ItemGroup>

</Project>
