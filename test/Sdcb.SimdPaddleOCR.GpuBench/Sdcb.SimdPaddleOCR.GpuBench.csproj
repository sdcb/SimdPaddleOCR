<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Dev harness only. Directory.Build.props already leaves test projects unpackable; CI does not build this one. -->
    <IsPackable>false</IsPackable>
    <AssemblyName>Sdcb.SimdPaddleOCR.GpuBench</AssemblyName>
    <RootNamespace>Sdcb.SimdPaddleOCR.GpuBench</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdPaddleOCR\Sdcb.SimdPaddleOCR.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>
</Project>
