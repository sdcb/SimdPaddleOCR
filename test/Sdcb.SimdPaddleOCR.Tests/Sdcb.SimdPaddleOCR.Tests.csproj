<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Sdcb.SimdPaddleOCR.Tests</AssemblyName>
    <RootNamespace>Sdcb.SimdPaddleOCR.Tests</RootNamespace>
    <UseNs20Library Condition="'$(UseNs20Library)' == ''">false</UseNs20Library>
    <!-- Opt-in: pulls RapidOcrNet + the ~700 MB ONNX Runtime CUDA package, so the
         default build (and CI) stays free of GPU natives. -->
    <EnableRapidOcr Condition="'$(EnableRapidOcr)' == ''">false</EnableRapidOcr>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseNs20Library)' == 'true'">
    <OutputPath>$(MSBuildProjectDirectory)/bin/$(Configuration)/ns20/</OutputPath>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)/obj/$(Configuration)/ns20/</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableRapidOcr)' == 'true'">
    <DefineConstants>$(DefineConstants);RAPIDOCR</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdPaddleOCR\Sdcb.SimdPaddleOCR.csproj">
      <SetTargetFramework Condition="'$(UseNs20Library)' == 'true'">TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny\Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.ChineseV6Small\Sdcb.SimdPaddleOCR.Models.ChineseV6Small.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.ChineseV6Medium\Sdcb.SimdPaddleOCR.Models.ChineseV6Medium.csproj" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNs20Library)' == 'true'">
    <!-- SetTargetFramework does not flow ns2.0 PackageReferences into the net10 host deps.json. -->
    <PackageReference Include="Microsoft.Bcl.Numerics" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableRapidOcr)' == 'true'">
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.29.0" />
    <!-- RapidOcrNet depends on the CPU native runtime, which owns the same
         onnxruntime.dll / onnxruntime_providers_shared.dll paths as the GPU package.
         Let the CUDA one win: keep the CPU package for the managed surface only. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" ExcludeAssets="native" />
  </ItemGroup>
</Project>
