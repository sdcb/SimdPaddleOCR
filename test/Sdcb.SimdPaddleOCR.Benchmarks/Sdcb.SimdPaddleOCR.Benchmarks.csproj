<Project Sdk="Microsoft.NET.Sdk">
  <!-- Metal per-graph / per-kernel profiler (macOS). Named Sdcb.SimdPaddleOCR.Benchmarks for the library's
       InternalsVisibleTo; build with -p:V200=true inside a v2.0.0 checkout for the old engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(V200)' == 'true'">$(DefineConstants);V200</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdPaddleOCR\Sdcb.SimdPaddleOCR.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
</Project>
