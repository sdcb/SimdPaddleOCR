<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sdcb.SimdPaddleOCR.UnitTests</RootNamespace>
    <UseNs20Library Condition="'$(UseNs20Library)' == ''">false</UseNs20Library>
    <DefineConstants Condition="'$(UseNs20Library)' == 'true'">$(DefineConstants);USE_NS20_LIBRARY</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseNs20Library)' == 'true'">
    <OutputPath>$(MSBuildProjectDirectory)/bin/$(Configuration)/ns20/</OutputPath>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)/obj/$(Configuration)/ns20/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNs20Library)' == 'true'">
    <!-- SetTargetFramework does not flow ns2.0 PackageReferences into the net10 host deps.json. -->
    <PackageReference Include="Microsoft.Bcl.Numerics" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdPaddleOCR\Sdcb.SimdPaddleOCR.csproj">
      <SetTargetFramework Condition="'$(UseNs20Library)' == 'true'">TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
