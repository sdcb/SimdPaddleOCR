<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Sdcb.PaddleOCR.Tests</AssemblyName>
    <RootNamespace>Sdcb.PaddleOCR.Tests</RootNamespace>
    <UseNs20Library Condition="'$(UseNs20Library)' == ''">false</UseNs20Library>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseNs20Library)' == 'true'">
    <OutputPath>$(MSBuildProjectDirectory)/bin/$(Configuration)/ns20/</OutputPath>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)/obj/$(Configuration)/ns20/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.PaddleOCR\Sdcb.PaddleOCR.csproj">
      <SetTargetFramework Condition="'$(UseNs20Library)' == 'true'">TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
    <ProjectReference Include="..\..\src\models\Sdcb.PaddleOCR.Models.ChineseV6Tiny\Sdcb.PaddleOCR.Models.ChineseV6Tiny.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.PaddleOCR.Models.ChineseV6Small\Sdcb.PaddleOCR.Models.ChineseV6Small.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.PaddleOCR.Models.ChineseV6Medium\Sdcb.PaddleOCR.Models.ChineseV6Medium.csproj" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNs20Library)' == 'true'">
    <!-- SetTargetFramework does not flow ns2.0 PackageReferences into the net10 host deps.json. -->
    <PackageReference Include="Microsoft.Bcl.Numerics" Version="10.0.11" />
  </ItemGroup>
</Project>
