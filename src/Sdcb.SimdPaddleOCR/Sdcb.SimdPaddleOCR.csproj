<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>Sdcb.SimdPaddleOCR</AssemblyName>
    <RootNamespace>Sdcb.SimdPaddleOCR</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>preview</LangVersion>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sdcb.SimdPaddleOCR.ModelProvider\Sdcb.SimdPaddleOCR.ModelProvider.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="linqpad-samples\*.linq" Pack="true" PackagePath="linqpad-samples" />
  </ItemGroup>
  <!-- the engine, compiled in as internal types (adds its ns2.0 polyfill packages too) -->
  <Import Project="$(SimdOnnxRoot)src\Sdcb.SimdOnnx\Sdcb.SimdOnnx.Sources.props" />
  <!-- ns2.0: CPU only (the engine's Vector<T> / scalar tiers). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Backends/**/*.cs" />
    <Compile Remove="**/*Avx*.cs" />
    <Compile Remove="**/*Avx512*.cs" />
    <Compile Remove="**/*AdvSimd.cs" />
    <Compile Remove="**/*PackedSimd.cs" />
    <Compile Remove="Kernels/Conv1x1.Int8Vnni.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Sdcb.SimdPaddleOCR" />
  </ItemGroup>
</Project>
