#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// NHWC channel-concat slice copy, 4 channels per thread (Cin%4==0, cOff%4==0):
//   o[px, cOff + c4*4 .. +4] = x[px, c4*4 .. +4]
// PC: hw, Cin, Cout, cOff

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { f16vec4 x[]; };
layout(set = 0, binding = 1) writeonly buffer O { f16vec4 o[]; };
layout(set = 0, binding = 2) readonly buffer RA { f16vec4 ra[]; };
layout(set = 0, binding = 3) readonly buffer SE { f16vec4 se[]; };

layout(push_constant) uniform PC { uint hw; uint Cin; uint Cout; uint cOff;
                                   uint flags; } p;
// flags bit8: x input is an unfused addps -> x[i]*se[c4]+ra[i]

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    uint cv = p.Cin >> 2;
    if (gid >= p.hw * cv) return;
    uint c4 = gid % cv;
    uint px = gid / cv;
    f16vec4 v = x[gid];
    if ((p.flags & 256u) != 0u) v = f16vec4(vec4(v) * vec4(se[c4]) + vec4(ra[gid]));
    o[px * (p.Cout >> 2) + (p.cOff >> 2) + c4] = v;
}
