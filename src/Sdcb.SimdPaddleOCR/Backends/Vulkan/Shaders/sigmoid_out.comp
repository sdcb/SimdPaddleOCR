#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Final DET head: fp16 → fp32 into the readback buffer, optional sigmoid.
// PC: n, act (0=copy 4=sigmoid)

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float16_t x[]; };
layout(set = 0, binding = 1) writeonly buffer O { float o[]; };

layout(push_constant) uniform PC { uint n; uint act; } p;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float v = float(x[i]);
    o[i] = (p.act == 4u) ? 1.0 / (1.0 + exp(-v)) : v;
}
