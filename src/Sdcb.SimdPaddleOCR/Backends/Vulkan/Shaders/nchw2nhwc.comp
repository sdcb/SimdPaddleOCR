#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Graph input convert: fp32 NCHW [1,C,H,W] → fp16 NHWC [H*W, Cout].
// Cout may exceed C (zero-padded channels for aligned downstream reads).
// PC: hw, C, Cout

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer O { float16_t o[]; };

layout(push_constant) uniform PC { uint hw; uint C; uint Cout; } p;

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    uint b = gl_GlobalInvocationID.y;
    uint total = p.hw * p.Cout;
    if (gid >= total) return;
    uint c = gid % p.Cout;
    uint px = gid / p.Cout;
    o[b * total + gid] = c < p.C
        ? float16_t(x[b * p.C * p.hw + c * p.hw + px]) : float16_t(0.0);
}
