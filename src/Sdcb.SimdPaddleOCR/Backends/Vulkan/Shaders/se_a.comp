#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// SE phase 1: per-partition partial sums of spatial mean on NHWC fp16.
// Same scheme as reduce_hw4 but lanes laid out on a pow2 channel grid
// (cvP = next_pow2(C/4)) so non-pow2 channel counts (e.g. C=48) still work.
// Workgroup s covers pixels [s*P, s*P+P); writes part[s*C + c] fp32.
// PC: hw, C, S, P, cvP

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { f16vec4 x[]; };
layout(set = 0, binding = 1) writeonly buffer Part { float part[]; };

layout(push_constant) uniform PC { uint hw; uint C; uint S; uint P; uint cvP; } p;

shared vec4 sm[256];

void main()
{
    uint s = gl_WorkGroupID.x;
    uint cv = p.C >> 2;
    uint lane = gl_LocalInvocationID.x;
    uint strips = 256u / p.cvP;
    uint strip = lane / p.cvP;
    uint cLane = lane - strip * p.cvP;
    vec4 acc = vec4(0.0);
    uint beg = s * p.P;
    uint end = min(beg + p.P, p.hw);
    if (cLane < cv)
        for (uint px = beg + strip; px < end; px += strips)
            acc += vec4(x[px * cv + cLane]);
    sm[lane] = acc;
    barrier();
    for (uint st = strips >> 1; st > 0u; st >>= 1) {
        if (strip < st) sm[lane] += sm[lane + st * p.cvP];
        barrier();
    }
    if (strip == 0u && cLane < cv) {
        uint ob = s * p.C + cLane * 4u;
        part[ob]      = sm[lane].x;
        part[ob + 1u] = sm[lane].y;
        part[ob + 2u] = sm[lane].z;
        part[ob + 3u] = sm[lane].w;
    }
}
