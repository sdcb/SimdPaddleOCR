<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdPaddleOCR\Sdcb.SimdPaddleOCR.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny\Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.ChineseV6Small\Sdcb.SimdPaddleOCR.Models.ChineseV6Small.csproj" />
    <ProjectReference Include="..\..\src\models\Sdcb.SimdPaddleOCR.Models.ChineseV6Medium\Sdcb.SimdPaddleOCR.Models.ChineseV6Medium.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.18" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>
  <Target Name="CopySampleImageToOutput" AfterTargets="CopyFilesToOutputDirectory">
    <MakeDir Directories="$(OutputPath)wwwroot" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\sample.jpg"
          DestinationFiles="$(OutputPath)wwwroot\sample.jpg"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopySampleImageToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)wwwroot" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\sample.jpg"
          DestinationFiles="$(PublishDir)wwwroot\sample.jpg"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
