<Project>
  <!--
    Independent NuGet versions. Edit here (and keep build/00-common.linq in sync).
    `dotnet pack -p:Version=` must not flow into referenced projects; see Directory.Build.targets.
  -->
  <PropertyGroup>
    <SdcbPaddleOCRVersion Condition="'$(SdcbPaddleOCRVersion)' == ''">4.0.0</SdcbPaddleOCRVersion>
    <SdcbPaddleOCRModelProviderVersion Condition="'$(SdcbPaddleOCRModelProviderVersion)' == ''">1.0.0</SdcbPaddleOCRModelProviderVersion>
    <SdcbPaddleOCRModelsTextLineOrientationVersion Condition="'$(SdcbPaddleOCRModelsTextLineOrientationVersion)' == ''">1.0.0</SdcbPaddleOCRModelsTextLineOrientationVersion>
    <SdcbPaddleOCRModelsChineseV6TinyVersion Condition="'$(SdcbPaddleOCRModelsChineseV6TinyVersion)' == ''">1.0.0</SdcbPaddleOCRModelsChineseV6TinyVersion>
    <SdcbPaddleOCRModelsChineseV6SmallVersion Condition="'$(SdcbPaddleOCRModelsChineseV6SmallVersion)' == ''">1.0.0</SdcbPaddleOCRModelsChineseV6SmallVersion>
    <SdcbPaddleOCRModelsChineseV6MediumVersion Condition="'$(SdcbPaddleOCRModelsChineseV6MediumVersion)' == ''">1.0.0</SdcbPaddleOCRModelsChineseV6MediumVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>sdcb</Authors>
    <Company>Sdcb</Company>
    <PackageProjectUrl>https://github.com/sdcb/Sdcb.PaddleOCR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sdcb/Sdcb.PaddleOCR.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>Sdcb;AI;OCR;PaddleOCR;PP-OCRv6</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryType>git</PublishRepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.PaddleOCR'">
    <Version>$(SdcbPaddleOCRVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Pure-managed PP-OCRv6 inference library. Accepts packed BGR8 memory only.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.PaddleOCR.ModelProvider'">
    <Version>$(SdcbPaddleOCRModelProviderVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>OCR model contracts (IPaddleOcrModelProvider / PaddleOcrModelBundle).</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.PaddleOCR.Models.TextLineOrientation'">
    <Version>$(SdcbPaddleOCRModelsTextLineOrientationVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-LCNet text-line orientation (CLS) model for PP-OCR.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.PaddleOCR.Models.ChineseV6Tiny'">
    <Version>$(SdcbPaddleOCRModelsChineseV6TinyVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv6 tiny Chinese DET+REC+dictionary models.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.PaddleOCR.Models.ChineseV6Small'">
    <Version>$(SdcbPaddleOCRModelsChineseV6SmallVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv6 small Chinese DET+REC+dictionary models.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.PaddleOCR.Models.ChineseV6Medium'">
    <Version>$(SdcbPaddleOCRModelsChineseV6MediumVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv6 medium Chinese DET+REC+dictionary models.</Description>
  </PropertyGroup>
</Project>
