<Project>
  <!--
    Independent NuGet versions. Edit here (and keep build/00-common.linq in sync).
    `dotnet pack -p:Version=` must not flow into referenced projects; see Directory.Build.targets.
  -->
  <PropertyGroup>
    <SdcbSimdPaddleOCRVersion Condition="'$(SdcbSimdPaddleOCRVersion)' == ''">2.0.0</SdcbSimdPaddleOCRVersion>
    <SdcbSimdPaddleOCRModelProviderVersion Condition="'$(SdcbSimdPaddleOCRModelProviderVersion)' == ''">1.1.0</SdcbSimdPaddleOCRModelProviderVersion>
    <SdcbSimdPaddleOCRModelsTextLineOrientationVersion Condition="'$(SdcbSimdPaddleOCRModelsTextLineOrientationVersion)' == ''">1.0.0</SdcbSimdPaddleOCRModelsTextLineOrientationVersion>
    <SdcbSimdPaddleOCRModelsDocumentOrientationVersion Condition="'$(SdcbSimdPaddleOCRModelsDocumentOrientationVersion)' == ''">1.0.0</SdcbSimdPaddleOCRModelsDocumentOrientationVersion>
    <SdcbSimdPaddleOCRModelsChineseV6TinyVersion Condition="'$(SdcbSimdPaddleOCRModelsChineseV6TinyVersion)' == ''">1.0.0</SdcbSimdPaddleOCRModelsChineseV6TinyVersion>
    <SdcbSimdPaddleOCRModelsChineseV6SmallVersion Condition="'$(SdcbSimdPaddleOCRModelsChineseV6SmallVersion)' == ''">1.0.0</SdcbSimdPaddleOCRModelsChineseV6SmallVersion>
    <SdcbSimdPaddleOCRModelsChineseV6MediumVersion Condition="'$(SdcbSimdPaddleOCRModelsChineseV6MediumVersion)' == ''">1.0.0</SdcbSimdPaddleOCRModelsChineseV6MediumVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>sdcb</Authors>
    <Company>Sdcb</Company>
    <PackageProjectUrl>https://github.com/sdcb/SimdPaddleOCR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sdcb/SimdPaddleOCR.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>Sdcb;AI;OCR;PaddleOCR;PP-OCRv6</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryType>git</PublishRepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdPaddleOCR'">
    <Version>$(SdcbSimdPaddleOCRVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Pure C# PP-OCRv6 inference (DET + CLS + REC). Cross-platform hand-written kernels and GEMM; optional GPU backends over Vulkan and Metal (macOS), .NET 10 only. Very high performance, low memory requirements, and very high accuracy. No Paddle Inference, ONNX Runtime, or OpenCV native libraries. Accepts interleaved BGR24 / RGB24 / BGRA32 / RGBA32.</Description>
    <PackageTags>Sdcb;AI;OCR;PaddleOCR;PP-OCRv6;linqpad-samples</PackageTags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdPaddleOCR.ModelProvider'">
    <Version>$(SdcbSimdPaddleOCRModelProviderVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>OCR model contracts (IPaddleOcrModelProvider / PaddleOcrModelBundle).</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdPaddleOCR.Models.TextLineOrientation'">
    <Version>$(SdcbSimdPaddleOCRModelsTextLineOrientationVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-LCNet text-line orientation (CLS) model for PP-OCR.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdPaddleOCR.Models.DocumentOrientation'">
    <Version>$(SdcbSimdPaddleOCRModelsDocumentOrientationVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Independent PP-LCNet_x1_0 document orientation model (0, 90, 180, 270 degrees). Simplified ONNX verified against Paddle.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny'">
    <Version>$(SdcbSimdPaddleOCRModelsChineseV6TinyVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv6 tiny Chinese DET+REC+dictionary models.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdPaddleOCR.Models.ChineseV6Small'">
    <Version>$(SdcbSimdPaddleOCRModelsChineseV6SmallVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv6 small Chinese DET+REC+dictionary models.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdPaddleOCR.Models.ChineseV6Medium'">
    <Version>$(SdcbSimdPaddleOCRModelsChineseV6MediumVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv6 medium Chinese DET+REC+dictionary models.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>
