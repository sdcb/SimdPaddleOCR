<Project>
  <!--
    `dotnet pack -p:Version=` is a global property. It would otherwise:
    1) flow into referenced project compiles, and
    2) be returned by NuGet's _GetProjectVersion as the package dependency version
       (that MSBuild call does not honor ProjectReference.GlobalPropertiesToRemove).
    Result: packing Sdcb.SimdPaddleOCR 1.0.1 would depend on ModelProvider 1.0.1.
  -->
  <ItemGroup>
    <ProjectReference Update="@(ProjectReference)">
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);Version;PackageVersion</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <Target Name="FixPackProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Sdcb.SimdPaddleOCR'">
        <ProjectVersion>$(SdcbSimdPaddleOCRVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Sdcb.SimdPaddleOCR.ModelProvider'">
        <ProjectVersion>$(SdcbSimdPaddleOCRModelProviderVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Sdcb.SimdPaddleOCR.Models.TextLineOrientation'">
        <ProjectVersion>$(SdcbSimdPaddleOCRModelsTextLineOrientationVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny'">
        <ProjectVersion>$(SdcbSimdPaddleOCRModelsChineseV6TinyVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Sdcb.SimdPaddleOCR.Models.ChineseV6Small'">
        <ProjectVersion>$(SdcbSimdPaddleOCRModelsChineseV6SmallVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Sdcb.SimdPaddleOCR.Models.ChineseV6Medium'">
        <ProjectVersion>$(SdcbSimdPaddleOCRModelsChineseV6MediumVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
